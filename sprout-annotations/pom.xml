<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.flix29</groupId>
        <artifactId>sprout</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>sprout-annotations</artifactId>

    <name>Sprout Annotations</name>
    <description>Compile-time REST scaffolding for Spring Boot - Annotations</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>flix29</id>
            <name>Felix Hallerbach</name>
            <email>info@flix29.de</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/Flix-29/Sprout.git</connection>
        <developerConnection>scm:git:git@github.com:flix-29/Sprout.git</developerConnection>
        <url>https://github.com/Flix-29/Sprout</url>
    </scm>
    <url>https://github.com/Flix-29/Sprout</url>
    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/Flix-29/Sprout/issues</url>
    </issueManagement>
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/Flix-29/Sprout/actions</url>
    </ciManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jakarta-persistence.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.persistence</groupId>
            <artifactId>javax.persistence-api</artifactId>
            <version>2.2</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>